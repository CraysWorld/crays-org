ays-project-and-partner-discussion-connected-to-the-governance-la.webp)","--nostr-hero-bg-position":"center center","--nostr-hero-bg-size":"cover"}},"children":["\n    ",{"tag":"div","attributes":{"className":"crays-article-shell crays-article-hero__grid"},"children":["\n      ",{"tag":"div","attributes":{"className":"crays-article-hero__content"},"children":["\n        ",{"tag":"p","attributes":{"className":"crays-article-kicker"},"children":["Governance"]},"\n        ",{"tag":"h1","attributes":{},"children":["Labels: Context Without a Central Verdict"]},"\n        ",{"tag":"p","attributes":{"className":"crays-article-deck"},"children":["Labels can add context, warnings and categories to Nostr events, but the issuer matters as much as the label."]},"\n        ",{"tag":"nav","attributes":{"className":"crays-nostr-article-related","aria-label":"Related Governance pages"},"children":["\n        ",{"tag":"a","attributes":{"href":"/nostr/governance/field-guide/reports/"},"children":["Reports"]},"\n        ",{"tag":"a","attributes":{"href":"/nostr/governance/deep-dives/moderation-without-a-king/"},"children":["Moderation"]},"\n      "]},"\n      "]},"\n      ",{"tag":"figure","attributes":{"className":"crays-article-hero__media"},"children":["\n        ",{"tag":"img","attributes":{"src":"/assets/stock-lifestyle/crays-association-22-crays-project-and-partner-discussion-connected-to-the-governance-la.webp","alt":"Project and partner discussion connected to a governance layer.","loading":"eager","decoding":"async"},"children":[]},"\n      "]},"\n    "]},"\n  "]},"\n\n  ",{"tag":"article","attributes":{"className":"crays-article-shell crays-nostr-article"},"children":["\n    ",{"tag":"section","attributes":{"className":"crays-nostr-article-intro"},"children":["\n      ",{"tag":"p","attributes":{"className":"crays-nostr-live-kicker"},"children":["NIP-32"]},"\n      ",{"tag":"h2","attributes":{},"children":["A label is a signed opinion with structure."]},"\n      ",{"tag":"p","attributes":{},"children":["NIP-32 gives software a way to attach labels to events, people or other entities. A label can categorize content, flag a risk, mark a topic or provide machine-readable context. It is tempting to treat labels as truth. That is the mistake."]},"\n",{"tag":"p","attributes":{},"children":["A label is useful because you can see who issued it. The same label from a trusted safety group, a random account, a satire bot or a hostile spammer carries different weight. Governance begins when the interface refuses to flatten those differences."]},"\n    "]},"\n    \n    ",{"tag":"section","attributes":{"className":"crays-nostr-article-section"},"children":["\n      ",{"tag":"h2","attributes":{},"children":["Labels are not moderation by themselves"]},"\n      ",{"tag":"p","attributes":{},"children":["A label can inform moderation, search, filtering or ranking, but it is not the action. A client may hide events with certain labels. A user may subscribe to a labeler. A community may require labels for explicit content. A relay may ignore labels entirely. The standard creates a common format; software and people decide what to do with it."]},"\n",{"tag":"p","attributes":{},"children":["That separation matters because it keeps labels from becoming a secret court. You can disagree with a labeler, switch lists, use another client, or inspect the event directly. A label should open context, not close debate."]},"\n    "]},"\n",{"tag":"section","attributes":{"className":"crays-nostr-hub-image-band crays-nostr-apps-collage crays-nostr-route-collage crays-nostr-governance-collage","id":"-nostr-governance-field-guide-labels--1","aria-label":"Labels: Context Without a Central Verdict visual break"},"children":["\n  ",{"tag":"div","attributes":{"className":"crays-article-shell crays-nostr-hub-image-band__grid"},"children":["\n    ",{"tag":"figure","attributes":{"className":"is-wide"},"children":[{"tag":"img","attributes":{"src":"/assets/stock-lifestyle/crays-association-08-the-system-stays-credible-when-decisions-are-documented-and-account.webp","alt":"A governance scene where documentation and accountability keep trust legible.","loading":"lazy","decoding":"async"},"children":[]}]},"\n    ",{"tag":"figure","attributes":{},"children":[{"tag":"img","attributes":{"src":"/assets/stock-images/crays-nostr-badge-membership-status.webp","alt":"A Nostr badge and membership status visual for reputation and public context.","loading":"lazy","decoding":"async"},"children":[]}]},"\n    ",{"tag":"figure","attributes":{"className":"is-wide"},"children":[{"tag":"img","attributes":{"src":"/assets/stock-lifestyle/crays-association-12-crays-management-discussion-around-a-business-table.webp","alt":"A focused table discussion about standards, membership and project rules.","loading":"lazy","decoding":"async"},"children":[]}]},"\n    ",{"tag":"figure","attributes":{},"children":[{"tag":"img","attributes":{"src":"/assets/stock-lifestyle/crays-association-03-crays-operating-and-governance-team-in-a-focused-meeting.webp","alt":"A governance team working through operational decisions.","loading":"lazy","decoding":"async"},"children":[]}]},"\n    ",{"tag":"figure","attributes":{},"children":[{"tag":"img","attributes":{"src":"/assets/stock-lifestyle/crays-association-22-crays-project-and-partner-discussion-connected-to-the-governance-la.webp","alt":"Project and partner discussion connected to a governance layer.","loading":"lazy","decoding":"async"},"children":[]}]},"\n  "]},"\n"]},"\n    ",{"tag":"section","attributes":{"className":"crays-nostr-article-section"},"children":["\n      ",{"tag":"h2","attributes":{},"children":["The best labels explain scope"]},"\n      ",{"tag":"p","attributes":{},"children":["Useful labels are boringly specific. Topic category. Content warning. Spam suspicion. Image classification. Language. Community rule. They avoid vague moral thunder. The more consequential the label, the more important it is to show issuer, time, target and reason."]},"\n",{"tag":"p","attributes":{},"children":["A label that affects visibility should be displayed differently from a label that merely improves search. A human safety label should be displayed differently from an automated classifier. Context is not just the text of the label; it is the path that produced it."]},"\n    "]},"\n\n    ",{"tag":"section","attributes":{"className":"crays-nostr-article-section"},"children":["\n      ",{"tag":"h2","attributes":{},"children":["Labels need appeal through pluralism"]},"\n      ",{"tag":"p","attributes":{},"children":["Nostr does not need one universal appeals department to make labels fairer. It needs plural labelers, clear provenance, competing clients and user control. If one labeler becomes sloppy or political, people can ignore that issuer. If a client hides too much, people can switch. That is not perfect justice, but it is a meaningful check on centralized judgment."]},"\n    "]},"\n",{"tag":"section","attributes":{"className":"crays-nostr-hub-image-band crays-nostr-apps-collage crays-nostr-route-collage crays-nostr-governance-collage","id":"-nostr-governance-field-guide-labels--3","aria-label":"Labels: Context Without a Central Verdict visual break"},"children":["\n  ",{"tag":"div","attributes":{"className":"crays-article-shell crays-nostr-hub-image-band__grid"},"children":["\n    ",{"tag":"figure","attributes":{"className":"is-wide"},"children":[{"tag":"img","attributes":{"src":"/assets/stock-lifestyle/crays-association-12-crays-management-discussion-around-a-business-table.webp","alt":"A focused table discussion about standards, membership and project rules.","loading":"lazy","decoding":"async"},"children":[]}]},"\n    ",{"tag":"figure","attributes":{},"children":[{"tag":"img","attributes":{"src":"/assets/stock-lifestyle/crays-association-03-crays-operating-and-governance-team-in-a-focused-meeting.webp","alt":"A governance team working through operational decisions.","loading":"lazy","decoding":"async"},"children":[]}]},"\n    ",{"tag":"figure","attributes":{"className":"is-wide"},"children":[{"tag":"img","attributes":{"src":"/assets/stock-lifestyle/crays-association-22-crays-project-and-partner-discussion-connected-to-the-governance-la.webp","alt":"Project and partner discussion connected to a governance layer.","loading":"lazy","decoding":"async"},"children":[]}]},"\n    ",{"tag":"figure","attributes":{},"children":[{"tag":"img","attributes":{"src":"/assets/stock-lifestyle/crays-association-18-crays-partners-discussing-association-standards-and-project-executi.webp","alt":"Partners discussing standards and project execution.","loading":"lazy","decoding":"async"},"children":[]}]},"\n    ",{"tag":"figure","attributes":{},"children":[{"tag":"img","attributes":{"src":"/assets/stock-lifestyle/crays-association-23-crays-association-members-preparing-a-project-decision.webp","alt":"Members preparing a public decision with rules, records and accountability.","loading":"lazy","decoding":"async"},"children":[]}]},"\n  "]},"\n"]},"\n    ",{"tag":"section","attributes":{"className":"crays-nostr-article-section"},"children":["\n      ",{"tag":"h2","attributes":{},"children":["Machine labels and human labels should not look the same"]},"\n      ",{"tag":"p","attributes":{},"children":["A machine classifier can label language, image content, spam likelihood or topic category at scale. A human labeler can add judgment, local knowledge and context. Both can be useful. They should not be visually flattened. If a label came from automation, say so. If it came from a person, show the signer. If it came from a community rule, show the room."]},"\n",{"tag":"p","attributes":{},"children":["This distinction protects people from false certainty. A machine may misread satire, dialect, political language or adult context. A human labeler may carry bias. A community label may be correct inside one room and irrelevant elsewhere. Labels become trustworthy when their limits are visible."]},"\n    "]},"\n\n    ",{"tag":"section","attributes":{"className":"crays-nostr-article-section"},"children":["\n      ",{"tag":"h2","attributes":{},"children":["Labels can improve search without becoming censorship"]},"\n      ",{"tag":"p","attributes":{},"children":["A label can help people find art, music, long-form writing, explicit media, local events or technical discussions. It can also help people avoid things they do not want to see. That is a positive use of structure. The danger comes when labels silently become global suppression rules."]},"\n",{"tag":"p","attributes":{},"children":["The safest pattern is local control. Let people choose which labelers they trust. Let clients show when a label changes ranking or visibility. Let communities define their own rules without pretending those rules apply to everyone."]},"\n    "]},"\n    ",{"tag":"section","attributes":{"className":"crays-nostr-article-sources","aria-label":"Sources"},"children":["\n    ",{"tag":"h2","attributes":{},"children":["Sources"]},"\n    ",{"tag":"ul","attributes":{},"children":["\n      ",{"tag":"li","attributes":{},"children":[{"tag":"a","attributes":{"href":"https://github.com/nostr-protocol/nips/blob/master/32.md"},"children":["NIP-32: labeling"]}]},"\n    "]},"\n  "]},"\n  "]},"\n"]},"\n",{"tag":"footer","attributes":{"className":"legal-footer crays-nostr-footer","aria-label":"Crays footer"},"children":["\n    ",{"tag":"div","attributes":{"className":"legal-footer-inner"},"children":["\n      ",{"tag":"div","attributes":{"className":"legal-footer-top"},"children":["\n        ",{"tag":"div","attributes":{},"children":["\n          ",{"tag":"a","attributes":{"className":"legal-footer-logo-link","href":"/","aria-label":"Crays Home"},"children":["\n            ",{"tag":"img","attributes":{"className":"legal-footer-logo","src":"/assets/brand/crays-logo.svg","alt":"Crays","width":"138","height":"34","loading":"lazy"},"children":[]},"\n          "]},"\n          ",{"tag":"p","attrib