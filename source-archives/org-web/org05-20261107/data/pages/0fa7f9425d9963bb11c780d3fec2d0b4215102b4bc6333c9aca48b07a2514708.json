ection","attributes":{"className":"crays-article-hero crays-nostr-hub-hero","style":{"--nostr-hero-bg":"url(/assets/stock-images/nostr-app-heroes/apps-relay-tools.jpg)","--nostr-hero-bg-position":"center 52%"}},"children":["\n        ",{"tag":"div","attributes":{"className":"crays-article-shell crays-article-hero__grid"},"children":["\n          ",{"tag":"div","attributes":{"className":"crays-article-hero__copy"},"children":["\n            ",{"tag":"p","attributes":{"className":"crays-article-eyebrow"},"children":["Relay profile"]},"\n            ",{"tag":"h1","attributes":{},"children":["nostr.wine"]},"\n            ",{"tag":"p","attributes":{"className":"crays-article-deck"},"children":["nostr.wine is one of the clearest paid-relay examples in Nostr: a public-facing service that sells admission, advertises performance and reliability, and makes the relay business model visible instead of pretending infrastructure is free."]},"\n          "]},"\n          ",{"tag":"div","attributes":{"className":"crays-nostr-hero-visual","style":{"--nostr-hero-visual-position":"center"}},"children":["\n            ",{"tag":"figure","attributes":{},"children":["\n              ",{"tag":"img","attributes":{"src":"/assets/nostr-free-stock/relays-visual.jpg","alt":"nostr.wine relay infrastructure visual","loading":"eager","decoding":"async"},"children":[]},"\n            "]},"\n            ",{"tag":"div","attributes":{"className":"crays-nostr-hero-avatar"},"children":[{"tag":"img","attributes":{"src":"https://www.google.com/s2/favicons?domain=nostr.wine&sz=128","alt":"nostr.wine icon","loading":"eager","decoding":"async"},"children":[]}]},"\n            ",{"tag":"div","attributes":{"className":"crays-nostr-hero-signal"},"children":["\n              ",{"tag":"span","attributes":{},"children":["Paid relay"]},"\n              ",{"tag":"strong","attributes":{},"children":["wss://nostr.wine"]},"\n              ",{"tag":"small","attributes":{},"children":["nostr.wine relay service, NIP-01, NIP-02, NIP-04, NIP-09, NIP-11, NIP-40, NIP-42, NIP-50, NIP-70"]},"\n            "]},"\n            ",{"tag":"div","attributes":{"className":"crays-nostr-hero-pins"},"children":["\n              ",{"tag":"a","attributes":{"href":"/nostr/relays/"},"children":["Relays"]},"\n              ",{"tag":"a","attributes":{"href":"/nostr/relays/#relays-live-operators"},"children":["Live operators"]},"\n              ",{"tag":"a","attributes":{"href":"/nostr/relays/nips/nip-11/"},"children":["NIP-11"]},"\n            "]},"\n          "]},"\n        "]},"\n      "]},"\n\n      ",{"tag":"section","attributes":{"className":"crays-article-main"},"children":["\n        ",{"tag":"div","attributes":{"className":"crays-article-reader-shell crays-article-layout"},"children":["\n          ",{"tag":"aside","attributes":{"className":"crays-article-toc","aria-label":"Reading path"},"children":["\n            ",{"tag":"p","attributes":{},"children":["Reading path"]},"\n            ",{"tag":"a","attributes":{"href":"#why-this-relay-matters"},"children":[{"tag":"span","attributes":{},"children":["01"]},"Why this relay matters"]},"\n            ",{"tag":"a","attributes":{"href":"#what-the-metadata-says"},"children":[{"tag":"span","attributes":{},"children":["02"]},"What the metadata says"]},"\n            ",{"tag":"a","attributes":{"href":"#policy-limits-and-trust"},"children":[{"tag":"span","attributes":{},"children":["03"]},"Policy, limits and trust"]},"\n            ",{"tag":"a","attributes":{"href":"#where-it-fits"},"children":[{"tag":"span","attributes":{},"children":["04"]},"Where it fits"]},"\n            ",{"tag":"a","attributes":{"href":"#how-to-evaluate-it"},"children":[{"tag":"span","attributes":{},"children":["05"]},"How to evaluate it"]},"\n            ",{"tag":"a","attributes":{"href":"#sources-worth-opening"},"children":[{"tag":"span","attributes":{},"children":["06"]},"Sources worth opening"]},"\n          "]},"\n\n          ",{"tag":"div","attributes":{"className":"crays-article-content"},"children":["\n\n            ",{"tag":"header","attributes":{"className":"crays-nostr-article-masthead"},"children":["\n              ",{"tag":"div","attributes":{"className":"crays-nostr-article-masthead__meta"},"children":[{"tag":"span","attributes":{},"children":["Relays"]},{"tag":"span","attributes":{},"children":["12 min read"]},{"tag":"span","attributes":{},"children":["Paid relay"]}]},"\n              ",{"tag":"h2","attributes":{"className":"crays-nostr-article-masthead__title"},"children":["nostr.wine"]},"\n              ",{"tag":"p","attributes":{"className":"crays-nostr-article-masthead__deck"},"children":["nostr.wine is one of the clearest paid-relay examples in Nostr: a public-facing service that sells admission, advertises performance and reliability, and makes the relay business model visible instead of pretending infrastructure is free."]},"\n            "]},"\n\n            ",{"tag":"div","attributes":{"className":"crays-nostr-reader-note"},"children":[{"tag":"strong","attributes":{},"children":["The quick read"]},{"tag":"span","attributes":{},"children":["nostr.wine matters because it turns the uncomfortable relay question into a product: who pays for storage, bandwidth, anti-spam work and operator attention? Free public relays are important, but paid relays expose the economic layer that has to exist if users want better reliability and less abuse. The current NIP-11 response was reachable during the June 18, 2026 check. It identifies the relay as nostr.wine, advertises NIP-01, NIP-02, NIP-04, NIP-09, NIP-11, NIP-40, NIP-42, NIP-50, NIP-70, and gives people a concrete way to compare the endpoint with other relays."]}]},"\n\n            ",{"tag":"h2","attributes":{"id":"why-this-relay-matters"},"children":["Why this relay matters"]},"\n            ",{"tag":"p","attributes":{},"children":["nostr.wine matters because it turns the uncomfortable relay question into a product: who pays for storage, bandwidth, anti-spam work and operator attention? Free public relays are important, but paid relays expose the economic layer that has to exist if users want better reliability and less abuse."]},"\n            ",{"tag":"p","attributes":{},"children":["A relay page is useful only when it explains the job the endpoint is doing. nostr.wine is not just the string ",{"tag":"code","attributes":{},"children":["wss://nostr.wine"]},". It is an operated place where signed events may be accepted, served, filtered, rate-limited, searched or ignored. That makes it part of the user's trust path, even when the relay never takes custody of a key or a coin."]},"\n            ",{"tag":"p","attributes":{},"children":["The practical question is simple: what happens if a client depends on this relay and the relay behaves differently than expected? A note may fail to publish, a reply may not be found, a profile may look empty, a wallet-connect message may miss the listener, or a user may assume censorship where the real issue is relay selection. Relay literacy starts there."]},"\n\n            ",{"tag":"h2","attributes":{"id":"what-the-metadata-says"},"children":["What the metadata says"]},"\n            ",{"tag":"p","attributes":{},"children":["The current NIP-11 response was reachable during the June 18, 2026 check. It identifies the relay as nostr.wine, advertises NIP-01, NIP-02, NIP-04, NIP-09, NIP-11, NIP-40, NIP-42, NIP-50, NIP-70, and gives people a concrete way to compare the endpoint with other relays."]},"\n            ",{"tag":"p","attributes":{},"children":["The relay advertises its software as ",{"tag":"strong","attributes":{},"children":["nostr.wine relay service"]},". Its contact field is ",{"tag":"strong","attributes":{},"children":["wino@nostr.wine"]},", and the public operator key shown in metadata is ",{"tag":"strong","attributes":{},"children":["4918eb332a41...20e55975"]},". These fields are not decoration. They give client developers and power users a place to start when a relay breaks, changes policy or becomes important enough to audit."]},"\n            ",{"tag":"p","attributes":{},"children":["The advertised limits are also part of the story. Maximum result limit is ",{"tag":"strong","attributes":{},"children":["1000"]},", maximum subscriptions are ",{"tag":"strong","attributes":{},"children":["50"]},", and maximum message length is ",{"tag":"strong","attributes":{},"children":["524288"]},". A client that ignores those boundaries may look broken even when the relay is doing exactly what it said it would do."]},"\n\n            ",{"tag":"h2","attributes":{"id":"policy-limits-and-trust"},"children":["Policy, limits and trust"]},"\n            ",{"tag":"p","attributes":{},"children":["This is not a frictionless public commons. The metadata advertises access controls: authentication required is no, payment required is yes, and restricted writes are yes. Those flags matter because they tell the user where policy enters the publishing path."]},"\n            ",{"tag":"p","attributes":{},"children":["The tension is access. Payment can reduce spam and fund operations, but it can also exclude users, create support expectations and make the relay feel more like a service contract than a neutral public commons."]},"\n            ",{"tag":"p","attributes":{},"children":["Good relay choice is therefore not a popularity contest. The better pattern is to ask what the relay is optimized for: broad public reach, paid access, spam resistance, search, profile discovery, wallet traffic, local community use or long-term archival storage. When the job is clear, the relay becomes easier to trust for that job and easier to replace for everything else."]},"\n\n            ",{"tag":"h2","attributes":{"id":"where-it-fits"},"children":["Where it fits in a relay set"]},"\n            ",{"tag":"p","attributes":{},"children":["Use nostr.wine when the user wants a paid relay with spam resistance and a clear admission model. It belongs beside public relays, not as a replacement for every relay, because reach still depends on where other people publish and read."]},"\n            ",{"tag":"p","attributes":{},"children":["A healthy Nostr setup usually mixes roles. One or two broad public relays help with reach. A personal or paid relay can improve durability. A search or directory relay helps discovery. A specialized relay handles wallet, group, media or filter behavior. nostr.wine belongs in that map as ",{"tag":"strong","attributes":{},"children":["paid relay"]},", not as a magic relay that solves every routing problem."]},"\n            ",{"tag":"p","attributes":{},"children":["That is why this page links both the live metadata and the surrounding sources. You should be able to open the endpoint, compare it with NIP-11, inspect the software or project behind it, and then decide whether the relay belongs in their client, their app defaults or their operational playbook."]},"\n\n            ",{"tag":"h2","attributes":{"id":"how-to-evaluate-it"},"children":["How to evaluate it today"]},"\n            ",{"tag":"p","attributes":{},"children":["Start with the relay information document, then test from a real client. Check whether publishing succeeds, whether reads return expected events, whether filters behave as expected, whether the relay appears in other people's relay lists, and whether a second client can find what the first one wrote."]},"\n            ",{"tag":"p","attributes":{},"children":["Then look at failure behavior. Does the relay return clear notices? Does it rate limit loudly or silently? Does authentication fail in a way a normal user can understand? Does the operator publish contact information? Does the software version suggest active maintenance? A relay that answers these questions is easier to recommend than a relay that merely connects."]},"\n            ",{"tag":"p","attributes":{},"children":["Finally, never let one endpoint become the whole plan. Nostr works because users can move across clients and relays. The moment a single relay becomes invisible infrastructure for a profile, product or payment flow, it deserves the same scrutiny as any other dependency."]},"\n\n            ",{"tag":"h2","attributes":{"id":"sources-worth-opening"},"children":["Sources worth opening"]},"\n            ",{"tag":"div","attributes":{"className":"crays-nostr-source-grid"},"children":["\n              ",{"tag":"a","attributes":{"className":"crays-nostr-source-card","href":"https://nostr.wine","target":"_blank","rel":"noopener"},"children":["\n                ",{"tag":"strong","attributes":{},"children":["nostr.wine NIP-11 metadata"]},"\n                ",{"tag":"span","attributes":{},"children":["The relay information document for wss://nostr.wine."]},"\n              "]},"\n",{"tag":"a","attributes":{"className":"crays-nostr-source-card","href":"https://nostr.wine/","target":"_blank","rel":"noopener"},"children":["\n                ",{"tag":"strong","attributes":{},"children":["nostr.wine"]},"\n                ",{"tag":"span","attributes":{},"children":["The official paid-relay site and admission path."]},"\n              "]},"\n",{"tag":"a","attributes":{"className":"crays-nostr-source-card","href":"https://github.com/nostr-protocol/nips/blob/master/42.md","target":"_blank","rel":"noopener"},"children":["\n                ",{"tag":"strong","attributes":{},"children":["NIP-42 client authentication"]},"\n                ",{"tag":"span","attributes":{},"children":["The authentication standard relevant to paid and restricted relay access."]},"\n              "]},"\n",{"tag":"a","attributes":{"className":"crays-nostr-source-card","href":"https://github.com/nostr-protocol/nips/blob/master/11.md","target":"_blank","rel":"noopener"},"children":["\n                ",{"tag":"strong","attributes":{},"children":["NIP-11 relay information document"]},"\n                ",{"tag":"span","attributes":{},"children":["The metadata standard behind relay names, limits, contact fields and supported NIPs."]},"\n              "]},"\n",{"tag":"a","attributes":{"className":"crays-nostr-source-card","href":"https://nostr.com/naddr1qq9hyetvv9uj6um9w36hqqghwaehxw309amxjar0wghxummnw3erztnrdakj7q3qgcxzte5zlkncx26j68ez60fzkvtkm9e0vrwdcvsjakxf9mu9qewqxpqqqp65wknqjt4","target":"_blank","rel":"noopener"},"children":["\n                ",{"tag":"strong","attributes":{},"children":["Nostr.com relay setup guide"]},"\n                ",{"tag":"span","attributes":{},"children":["A practical relay-selection note that points people toward public, personal and paid relay mixes."]},"\n              "]},"\n",{"tag":"a","attributes":{"className":"crays-nostr-source-card","href":"https://nostr.co.uk/relays/","target":"_blank","rel":"noopener"},"children":["\n                ",{"tag":"strong","attributes":{},"children":["Nostr.co.uk relay directory"]},"\n                ",{"tag":"span","attributes":{},"children":["A public directory that separates general, paid, specialized and regional relay choices."]},"\n              "]},"\n            "]},"\n          "]},"\n        "]},"\n      "]},"\n    "]},"\n  "]},"\n\n",{"tag":"footer","attributes":{"className":"legal-footer crays-nostr-footer","aria-label":"Crays footer"},"children":["\n    ",{"tag":"div","attributes":{"className":"legal-footer-inner"},"children":["\n      ",{"tag":"div","attributes":{"className":"legal-footer-top"},"children":["\n        ",{"tag":"div","attributes":{},"children":["\n          ",{"tag":"a","attributes":{"className":"legal-footer-logo-link","href":"/","aria-label":"Crays Home"},"children":["\n            ",{"tag":"img","attributes":{"className":"legal-footer-logo","src":"/assets/brand/crays-logo.svg","alt":"Crays","width":"138","height":"34","loading":"lazy"},"children":[]},"\n          "]},"\n          ",{"tag":"p","attributes":{"className":"legal-footer-tagline"},"children":["Luxury, Lifestyle, Wealth and Innovation"]},"\n        "]},"\n        ",{"tag":"div","attributes":{"className":"legal-footer-social","aria-label":"Social links"},"children"