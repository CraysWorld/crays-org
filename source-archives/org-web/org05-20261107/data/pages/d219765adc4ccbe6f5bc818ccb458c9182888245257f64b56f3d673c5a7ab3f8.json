es/association-venue-tech/association-venue-tech-digital-rails.webp)","--nostr-hero-bg-position":"center center","--nostr-hero-bg-size":"cover"}},"children":["\n      ",{"tag":"div","attributes":{"className":"crays-article-shell crays-article-hero__grid"},"children":["\n        ",{"tag":"div","attributes":{"className":"crays-article-hero__copy"},"children":["\n          ",{"tag":"p","attributes":{"className":"crays-article-eyebrow"},"children":["Relays / Outbox discovery"]},"\n          ",{"tag":"h1","attributes":{},"children":["The Outbox Model: Find People Where They Publish"]},"\n          ",{"tag":"p","attributes":{"className":"crays-article-deck"},"children":["Outbox thinking makes relay discovery less random by following the places where each person actually writes."]},"\n        "]},"\n        ",{"tag":"div","attributes":{"className":"crays-nostr-hero-visual","style":{"--nostr-hero-visual-position":"center"}},"children":["\n          ",{"tag":"figure","attributes":{},"children":[{"tag":"img","attributes":{"src":"/assets/stock-images/association-venue-tech/association-venue-tech-digital-rails.webp","alt":"The Outbox Model: Find People Where They Publish visual","loading":"eager","decoding":"async"},"children":[]}]},"\n          ",{"tag":"div","attributes":{"className":"crays-nostr-hero-signal"},"children":["\n            ",{"tag":"span","attributes":{},"children":["Relays"]},"\n            ",{"tag":"strong","attributes":{},"children":["Outbox discovery"]},"\n            ",{"tag":"small","attributes":{},"children":["Endpoints, policy, metadata and reliability before the next dependency."]},"\n          "]},"\n          ",{"tag":"div","attributes":{"className":"crays-nostr-hero-pins"},"children":["\n            ",{"tag":"a","attributes":{"href":"/nostr/relays/"},"children":["Relays"]},"\n            ",{"tag":"a","attributes":{"href":"/nostr/relays/nips/nip-11/"},"children":["NIP-11"]},"\n            ",{"tag":"a","attributes":{"href":"/nostr/relays/research-atlas/"},"children":["Sources"]},"\n          "]},"\n        "]},"\n      "]},"\n    "]},"\n\n    ",{"tag":"section","attributes":{"className":"crays-article-main"},"children":["\n      ",{"tag":"div","attributes":{"className":"crays-article-shell crays-article-layout"},"children":["\n        ",{"tag":"aside","attributes":{"className":"crays-article-toc","aria-label":"Reading path"},"children":["\n          ",{"tag":"p","attributes":{},"children":["Reading path"]},"\n          ",{"tag":"a","attributes":{"href":"#the-problem-with-one-global-door"},"children":[{"tag":"span","attributes":{},"children":["01"]},"The problem with one global door"]},"\n          ",{"tag":"a","attributes":{"href":"#relay-lists-become-social-infrastructure"},"children":[{"tag":"span","attributes":{},"children":["02"]},"Relay lists become social infrastructure"]},"\n          ",{"tag":"a","attributes":{"href":"#outbox-is-product-design-not-only-protocol"},"children":[{"tag":"span","attributes":{},"children":["03"]},"Outbox is product design, not only protocol"]},"\n          ",{"tag":"a","attributes":{"href":"#why-this-matters-for-communities"},"children":[{"tag":"span","attributes":{},"children":["04"]},"Why this matters for communities"]},"\n          ",{"tag":"a","attributes":{"href":"#what-to-watch-next"},"children":[{"tag":"span","attributes":{},"children":["05"]},"What to watch next"]},"\n        "]},"\n        ",{"tag":"div","attributes":{"className":"crays-article-content"},"children":["\n          ",{"tag":"header","attributes":{"className":"crays-nostr-article-masthead"},"children":["\n            ",{"tag":"div","attributes":{"className":"crays-nostr-article-masthead__meta"},"children":[{"tag":"span","attributes":{},"children":["Relays"]},{"tag":"span","attributes":{},"children":["448 words"]},{"tag":"span","attributes":{},"children":["Outbox discovery"]}]},"\n            ",{"tag":"h2","attributes":{"className":"crays-nostr-article-masthead__title"},"children":["The Outbox Model: Find People Where They Publish"]},"\n            ",{"tag":"p","attributes":{"className":"crays-nostr-article-masthead__deck"},"children":["Outbox thinking makes relay discovery less random by following the places where each person actually writes."]},"\n          "]},"\n          ",{"tag":"aside","attributes":{"className":"crays-nostr-source-card","aria-label":"Quick read"},"children":[{"tag":"strong","attributes":{},"children":["The quick read"]},{"tag":"span","attributes":{},"children":["Use this when a timeline looks incomplete. The outbox model explains why a client should not ask a fixed global relay set for everyone. It should learn where each profile publishes and query those places intelligently."]}]},"\n          ",{"tag":"h2","attributes":{"id":"the-problem-with-one-global-door"},"children":["The problem with one global door"]},"\n          ",{"tag":"p","attributes":{},"children":["A centralized social app has one main database. Nostr does not. That is the point, but it creates a discovery problem. If a client asks only its own default relays for every person, it may miss events published elsewhere. If it asks every known relay, it becomes slow, expensive and noisy."]},"\n          ",{"tag":"p","attributes":{},"children":["The outbox model offers a more human answer: follow each person to the relays where they publish. If Alice writes to one set and Bob writes to another, a smart client learns both instead of pretending the whole network lives behind one door."]},"\n          ",{"tag":"h2","attributes":{"id":"relay-lists-become-social-infrastructure"},"children":["Relay lists become social infrastructure"]},"\n          ",{"tag":"p","attributes":{},"children":["NIP-65 relay list metadata gives outbox discovery a public clue. A profile can say, in effect, 'these are the places where I write and read.' Clients can use that to build better queries. The result is not perfect, but it is a major improvement over blind relay guessing."]},"\n          ",{"tag":"p","attributes":{},"children":["This also makes your relay choices more consequential. If your published list is stale, others may look in the wrong place. If your write relays are unreliable, your profile may appear fragmented. If your client never updates the list, portability slowly decays."]},"\n          ",{"tag":"h2","attributes":{"id":"outbox-is-product-design-not-only-protocol"},"children":["Outbox is product design, not only protocol"]},"\n          ",{"tag":"p","attributes":{},"children":["The hard part is not just reading a relay-list event. The hard part is turning it into a feed that feels normal. A client has to cache hints, merge responses, avoid duplicates, handle failed relays, update stale data and explain enough of the process when a user needs to troubleshoot."]},"\n          ",{"tag":"p","attributes":{},"children":["Done well, outbox discovery makes Nostr feel less random. Done poorly, it can make feeds look broken without telling you why. That is why relays, clients and standards have to be discussed together."]},"\n          ",{"tag":"h2","attributes":{"id":"why-this-matters-for-communities"},"children":["Why this matters for communities"]},"\n          ",{"tag":"p","attributes":{},"children":["Communities do not all live in the same place. A Bitcoin-heavy cluster may use one set of relays. A local event group may use another. A developer community may rely on fast public relays and search tools. Outbox discovery lets those communities remain separate without becoming invisible to each other."]},"\n          ",{"tag":"p","attributes":{},"children":["This is especially important for Crays-style local spaces, venues and membership layers. A real-world community can use relays that make sense for its context while still being reachable from the broader Nostr map."]},"\n          ",{"tag":"h2","attributes":{"id":"what-to-watch-next"},"children":["What to watch next"]},"\n          ",{"tag":"p","attributes":{},"children":["Watch how clients expose relay health, relay lists and discovery settings. A good client should not make you babysit every endpoint, but it should give you enough visibility to understand why an event is missing."]},"\n          ",{"tag":"p","attributes":{},"children":["Also watch relay monitoring and liveness standards. Outbox discovery is only as good as the relay signals underneath it. If clients cannot tell whether relays are alive, slow, paid, restricted or stale, the map remains fuzzy."]},"\n          ",{"tag":"h2","attributes":{"id":"sources-worth-opening"},"children":["Sources worth opening"]},"\n          ",{"tag":"p","attributes":{},"children":["Open these when you want the standard, implementation, monitor or operator trail behind the page."]},"\n          ",{"tag":"ul","attributes":{},"children":["\n            ",{"tag":"li","attributes":{},"children":[{"tag":"a","attributes":{"href":"https://github.com/nostr-protocol/nips/blob/master/65.md","target":"_blank","rel":"noreferrer noopener"},"children":["NIP-65: Relay list metadata"]}]},"\n            ",{"tag":"li","attributes":{},"children":[{"tag":"a","attributes":{"href":"https://nostrdesign.org/docs/relays/","target":"_blank","rel":"noreferrer noopener"},"children":["Nostr Design: Relays"]}]},"\n            ",{"tag":"li","attributes":{},"children":[{"tag":"a","attributes":{"href":"https://github.com/nostr-protocol/nips/blob/master/50.md","target":"_blank","rel":"noreferrer noopener"},"children":["NIP-50: Search capability"]}]},"\n            ",{"tag":"li","attributes":{},"children":[{"tag":"a","attributes":{"href":"https://github.com/nostr-protocol/nips/blob/master/66.md","target":"_blank","rel":"noreferrer noopener"},"children":["NIP-66: Relay liveness monitoring"]}]},"\n          "]},"\n          ",{"tag":"h2","attributes":{"id":"useful-next-pages"},"children":["Useful next pages"]},"\n          ",{"tag":"nav","attributes":{"className":"crays-nostr-apps-ecosystem-nav","aria-label":"Related Relay routes"},"children":[{"tag":"a","attribu