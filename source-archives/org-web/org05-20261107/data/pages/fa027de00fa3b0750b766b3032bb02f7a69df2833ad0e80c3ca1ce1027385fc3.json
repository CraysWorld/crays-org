ro","style":{"--nostr-hero-bg":"url(/assets/stock-lifestyle/crays-association-03-crays-operating-and-governance-team-in-a-focused-meeting.webp)","--nostr-hero-bg-position":"center center","--nostr-hero-bg-size":"cover"}},"children":["\n    ",{"tag":"div","attributes":{"className":"crays-article-shell crays-article-hero__grid"},"children":["\n      ",{"tag":"div","attributes":{"className":"crays-article-hero__content"},"children":["\n        ",{"tag":"p","attributes":{"className":"crays-article-kicker"},"children":["Governance"]},"\n        ",{"tag":"h1","attributes":{},"children":["Software Reputation and Receipts"]},"\n        ",{"tag":"p","attributes":{"className":"crays-article-deck"},"children":["Software reputation on Nostr comes from maintainers, commits, signatures, issue history, user reports and the ability to leave."]},"\n        ",{"tag":"nav","attributes":{"className":"crays-nostr-article-related","aria-label":"Related Governance pages"},"children":["\n        ",{"tag":"a","attributes":{"href":"/nostr/apps/"},"children":["Apps"]},"\n        ",{"tag":"a","attributes":{"href":"/nostr/privacy/clients-and-signers/"},"children":["Clients and signers"]},"\n      "]},"\n      "]},"\n      ",{"tag":"figure","attributes":{"className":"crays-article-hero__media"},"children":["\n        ",{"tag":"img","attributes":{"src":"/assets/stock-lifestyle/crays-association-03-crays-operating-and-governance-team-in-a-focused-meeting.webp","alt":"A governance team working through operational decisions.","loading":"eager","decoding":"async"},"children":[]},"\n      "]},"\n    "]},"\n  "]},"\n\n  ",{"tag":"article","attributes":{"className":"crays-article-shell crays-nostr-article"},"children":["\n    ",{"tag":"section","attributes":{"className":"crays-nostr-article-intro"},"children":["\n      ",{"tag":"p","attributes":{"className":"crays-nostr-live-kicker"},"children":["Receipts"]},"\n      ",{"tag":"h2","attributes":{},"children":["Trust the trail more than the logo."]},"\n      ",{"tag":"p","attributes":{},"children":["Nostr products are often small, fast-moving and maintained by tiny teams. That energy is part of the charm. It is also a risk. A client can ask for signing authority. A relay can shape visibility. A wallet connection can move money. A moderation tool can hide people. Software reputation therefore belongs in governance, not only in Apps."]},"\n",{"tag":"p","attributes":{},"children":["The useful question is simple: what can this software touch, and what proof can you inspect before trusting it?"]},"\n    "]},"\n    \n    ",{"tag":"section","attributes":{"className":"crays-nostr-article-section"},"children":["\n      ",{"tag":"h2","attributes":{},"children":["Maintenance is a trust signal"]},"\n      ",{"tag":"p","attributes":{},"children":["A repository with active commits, issues, releases and public maintainers gives you a different risk picture than an abandoned binary. Open source is not automatic safety, but it creates a trail. You can see whether bugs are fixed, whether security issues are handled, whether dependencies move and whether other builders rely on the code."]},"\n    "]},"\n",{"tag":"section","attributes":{"className":"crays-nostr-hub-image-band crays-nostr-apps-collage crays-nostr-route-collage crays-nostr-governance-collage","id":"-nostr-governance-field-guide-software-reputation--1","aria-label":"Software Reputation and Receipts visual break"},"children":["\n  ",{"tag":"div","attributes":{"className":"crays-article-shell crays-nostr-hub-image-band__grid"},"children":["\n    ",{"tag":"figure","attributes":{"className":"is-wide"},"children":[{"tag":"img","attributes":{"src":"/assets/stock-lifestyle/crays-association-08-the-system-stays-credible-when-decisions-are-documented-and-account.webp","alt":"A governance scene where documentation and accountability keep trust legible.","loading":"lazy","decoding":"async"},"children":[]}]},"\n    ",{"tag":"figure","attributes":{},"children":[{"tag":"img","attributes":{"src":"/assets/stock-images/crays-nostr-badge-membership-status.webp","alt":"A Nostr badge and membership status visual for reputation and public context.","loading":"lazy","decoding":"async"},"children":[]}]},"\n    ",{"tag":"figure","attributes":{"className":"is-wide"},"children":[{"tag":"img","attributes":{"src":"/assets/stock-lifestyle/crays-association-12-crays-management-discussion-around-a-business-table.webp","alt":"A focused table discussion about standards, membership and project rules.","loading":"lazy","decoding":"async"},"children":[]}]},"\n    ",{"tag":"figure","attributes":{},"children":[{"tag":"img","attributes":{"src":"/assets/stock-lifestyle/crays-association-03-crays-operating-and-governance-team-in-a-focused-meeting.webp","alt":"A governance team working through operational decisions.","loading":"lazy","decoding":"async"},"children":[]}]},"\n    ",{"tag":"figure","attributes":{},"children":[{"tag":"img","attributes":{"src":"/assets/stock-lifestyle/crays-association-22-crays-project-and-partner-discussion-connected-to-the-governance-la.webp","alt":"Project and partner discussion connected to a governance layer.","loading":"lazy","decoding":"async"},"children":[]}]},"\n  "]},"\n"]},"\n    ",{"tag":"section","attributes":{"className":"crays-nostr-article-section"},"children":["\n      ",{"tag":"h2","attributes":{},"children":["Screenshots are weak receipts"]},"\n      ",{"tag":"p","attributes":{},"children":["Screenshots can be useful for explaining a UI, but they are poor proof when conflict starts. Signed events, commit links, release notes, issue threads, NIP references and reproducible behavior are stronger. A good governance archive should prefer direct links over dramatic screenshots."]},"\n    "]},"\n\n    ",{"tag":"section","attributes":{"className":"crays-nostr-article-section"},"children":["\n      ",{"tag":"h2","attributes":{},"children":["Permissions matter more than polish"]},"\n      ",{"tag":"p","attributes":{},"children":["A beautiful client that asks for raw private-key entry deserves more caution than a rough interface using a safer signer. A wallet connection with broad permissions deserves more scrutiny than a limited budget. A moderation tool that hides sources deserves more skepticism than one that shows the rule."]},"\n    "]},"\n",{"tag":"section","attributes":{"className":"crays-nostr-hub-image-band crays-nostr-apps-collage crays-nostr-route-collage crays-nostr-governance-collage","id":"-nostr-governance-field-guide-software-reputation--3","aria-label":"Software Reputation and Receipts visual break"},"children":["\n  ",{"tag":"div","attributes":{"className":"crays-article-shell crays-nostr-hub-image-band__grid"},"children":["\n    ",{"tag":"figure","attributes":{"className":"is-wide"},"children":[{"tag":"img","attributes":{"src":"/assets/stock-lifestyle/crays-association-12-crays-management-discussion-around-a-business-table.webp","alt":"A focused table discussion about standards, membership and project rules.","loading":"lazy","decoding":"async"},"children":[]}]},"\n    ",{"tag":"figure","attributes":{},"children":[{"tag":"img","attributes":{"src":"/assets/stock-lifestyle/crays-association-03-crays-operating-and-governance-team-in-a-focused-meeting.webp","alt":"A governance team working through operational decisions.","loading":"lazy","decoding":"async"},"children":[]}]},"\n    ",{"tag":"figure","attributes":{"className":"is-wide"},"children":[{"tag":"img","attributes":{"src":"/assets/stock-lifestyle/crays-association-22-crays-project-and-partner-discussion-connected-to-the-governance-la.webp","alt":"Project and partner discussion connected to a governance layer.","loading":"lazy","decoding":"async"},"children":[]}]},"\n    ",{"tag":"figure","attributes":{},"children":[{"tag":"img","attributes":{"src":"/assets/stock-lifestyle/crays-association-18-crays-partners-discussing-association-standards-and-project-executi.webp","alt":"Partners discussing standards and project execution.","loading":"lazy","decoding":"async"},"children":[]}]},"\n    ",{"tag":"figure","attributes":{},"children":[{"tag":"img","attributes":{"src":"/assets/stock-lifestyle/crays-association-23-crays-association-members-preparing-a-project-decision.webp","alt":"Members preparing a public decision with rules, records and accountability.","loading":"lazy","decoding":"async"},"children":[]}]},"\n  "]},"\n"]},"\n    ",{"tag":"section","attributes":{"className":"crays-nostr-article-section"},"children":["\n      ",{"tag":"h2","attributes":{},"children":["Permissions are a reputation surface"]},"\n      ",{"tag":"p","attributes":{},"children":["Software reputation is not only whether a maintainer is famous. It is whether the product asks for appropriate power. A client that requests a signer permission for a narrow action is different from a website asking you to paste an nsec. A wallet tool with spending limits is different from one with broad authority. A relay management tool with clear authentication is different from a hidden admin panel."]},"\n",{"tag":"p","attributes":{},"children":["That is why permissions belong in the governance route. They decide who can act as you, spend for you, hide things from you or publish under your key. The more power a product requests, the more public receipts it should provide."]},"\n    "]},"\n\n    ",{"tag":"section","attributes":{"className":"crays-nostr-article-section"},"children":["\n      ",{"tag":"h2","attributes":{},"children":["Community memory can protect newcomers"]},"\n      ",{"tag":"p","attributes":{},"children":["Nostr has many small tools with uneven documentation. Public notes, GitHub issues, app profiles, maintainer identities and repeated user reports become part of the safety layer. A good archive does not turn that memory into gossip. It turns it into links you can inspect before trusting a product."]},"\n    "]},"\n\n    ",{"tag":"section","attributes":{"className":"crays-nostr-article-section"},"children":["\n      ",{"tag":"h2","attributes":{},"children":["The exit test is simple"]},"\n      ",{"tag":"p","attributes":{},"children":["Before trusting software, ask what happens if it disappears. Can you export keys? Can you switch clients? Can you revoke a wallet connection? Can you find your media? Can another relay serve your events? If the answer is no, the product may still be useful, but it is asking for platform-style trust."]},"\n    "]},"\n    ",{"tag":"section","attributes":{"className":"crays-nostr-article-sources","aria-label":"Sources"},"children":["\n    ",{"tag":"h2","attributes":{},"children":["Sources"]},"\n    ",{"tag":"ul","attributes":{},"children":["\n      ",{"tag":"li","attributes":{},"children":[{"tag":"a","attributes":{"href":"https://github.com/nostr-protocol/nips"},"children":["NIP repository"]}]},"\n      ",{"tag":"li","attributes":{},"children":[{"tag":"a","attributes":{"href":"https://github.com/nostr-protocol/nips/blob/master/01.md"},"children":["NIP-01: basic protocol flow"]}]},"\n      ",{"tag":"li","attributes":{},"children":[{"tag":"a","attributes":{"href":"https://github.com/nostr-protocol/nips/blob/master/56.md"},"children":["NIP-56: reporting"]}]},"\n    "]},"\n  "]},"\n  "]},"\n"]},"\n",{"tag":"footer","attributes":{"className":"legal-footer crays-nostr-footer","aria-label":"Crays footer"},"children":["\n    ",{"tag":"div","attributes":{"className":"legal-footer-inner"},"children":["\n      ",{"tag":"div","attributes":{"className":"legal-footer-top"},"children":["\n        ",{"tag":"div","attributes":{},"children":["\n          ",{"tag":"a","attributes":{"className":"legal-footer-logo-link","href":"/","aria-label":"Crays Home"},"children":["\n            ",{"tag":"img","attributes":{"className":"legal-footer-logo","src":"/assets/brand/crays-logo.svg","alt":"Crays","width":"138","height":"34","loading":"lazy"},"children":[]},"\n          "]},"\n          ",{"tag":"p","attributes":{"className":"legal-footer-tagline"},"children":["Luxury, Lifestyl