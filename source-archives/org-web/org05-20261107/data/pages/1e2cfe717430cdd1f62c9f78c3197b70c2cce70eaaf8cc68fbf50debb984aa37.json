n":"center center","--nostr-hero-bg-size":"cover"}},"children":[" ",{"tag":"div","attributes":{"className":"crays-article-shell crays-article-hero__grid"},"children":[" ",{"tag":"div","attributes":{"className":"crays-article-hero__copy"},"children":[" ",{"tag":"p","attributes":{"className":"crays-article-eyebrow"},"children":["Wallets / Records"]}," ",{"tag":"h1","attributes":{},"children":["Safebox and Sovereign Wallet Records"]}," ",{"tag":"p","attributes":{"className":"crays-article-deck"},"children":["Wallets are not only balances. A real value layer also needs records: keys, recovery hints, receipts, encrypted notes, media pointers and the private state that lets a person move without losing context."]}," "]}," ",{"tag":"div","attributes":{"className":"crays-nostr-hero-visual","style":{"--nostr-hero-visual-position":"center 42%"}},"children":[" ",{"tag":"figure","attributes":{},"children":[{"tag":"img","attributes":{"src":"/assets/stock-lifestyle/crays-tech-hero-intent-blackboard-doorway.jpg","alt":"Safebox and Sovereign Wallet Records visual","loading":"eager","decoding":"async"},"children":[]}]}," ",{"tag":"div","attributes":{"className":"crays-nostr-hero-signal"},"children":[" ",{"tag":"span","attributes":{},"children":["Wallets"]}," ",{"tag":"strong","attributes":{},"children":["Records"]}," ",{"tag":"small","attributes":{},"children":["Value, permission, custody and proof before the next payment."]}," "]}," "]}," "]}," "]}," ",{"tag":"section","attributes":{"className":"crays-article-main"},"children":[" ",{"tag":"div","attributes":{"className":"crays-article-shell crays-article-layout"},"children":[" ",{"tag":"aside","attributes":{"className":"crays-article-toc","aria-label":"In this article"},"children":[" ",{"tag":"p","attributes":{},"children":["In this article"]}," ",{"tag":"a","attributes":{"href":"#the-wallet-record-is-the-quiet-layer"},"children":[{"tag":"span","attributes":{},"children":["01"]},"The wallet record is the quiet layer"]}," ",{"tag":"a","attributes":{"href":"#why-this-is-different-from-a-normal-notes-app"},"children":[{"tag":"span","attributes":{},"children":["02"]},"Why this is different from a normal notes app"]}," ",{"tag":"a","attributes":{"href":"#the-recovery-question"},"children":[{"tag":"span","attributes":{},"children":["03"]},"The recovery question"]}," ",{"tag":"a","attributes":{"href":"#where-nostr-helps"},"children":[{"tag":"span","attributes":{},"children":["04"]},"Where Nostr helps"]}," ",{"tag":"a","attributes":{"href":"#where-it-connects-to-crays"},"children":[{"tag":"span","attributes":{},"children":["05"]},"Where it connects to Crays"]}," ",{"tag":"a","attributes":{"href":"#what-to-verify"},"children":[{"tag":"span","attributes":{},"children":["06"]},"What to verify"]}," ",{"tag":"a","attributes":{"href":"#why-it-still-belongs-here"},"children":[{"tag":"span","attributes":{},"children":["07"]},"Why it still belongs here"]}," "]}," ",{"tag":"div","attributes":{"className":"crays-article-content"},"children":[" ",{"tag":"header","attributes":{"className":"crays-nostr-article-masthead"},"children":[" ",{"tag":"div","attributes":{"className":"crays-nostr-article-masthead__meta"},"children":[{"tag":"span","attributes":{},"children":["Wallets"]},{"tag":"span","attributes":{},"children":["682 words"]},{"tag":"span","attributes":{},"children":["Records"]}]}," ",{"tag":"h2","attributes":{"className":"crays-nostr-article-masthead__title"},"children":["Safebox and Sovereign Wallet Records"]}," ",{"tag":"p","attributes":{"className":"crays-nostr-article-masthead__deck"},"children":["Wallets are not only balances. A real value layer also needs records: keys, recovery hints, receipts, encrypted notes, media pointers and the private state that lets a person move without losing context."]}," "]}," ",{"tag":"aside","attributes":{"className":"crays-nostr-source-card","aria-label":"Quick read"},"children":[{"tag":"strong","attributes":{},"children":["The quick read"]},{"tag":"span","attributes":{},"children":["Open this when Safebox appears in the wallet map. The useful question is not whether it sounds sovereign, but what private records it stores, how Nostr carries them, how recovery works and where the trust boundary sits."]}]}," ",{"tag":"h2","attributes":{"id":"the-wallet-record-is-the-quiet-layer"},"children":["The wallet record is the quiet layer"]}," ",{"tag":"p","attributes":{},"children":["Most wallet pages talk about balances and payments because those are easy to see. The harder layer is private state: what did you connect, which key controls what, where are receipts, what recovery hint exists, which media or document belongs to which transaction and how can you move between clients without losing the map?"]}," ",{"tag":"p","attributes":{},"children":["Safebox belongs in the Wallets route as a records idea, not as a generic payment app. The interesting problem is the space between identity, wallet state, encrypted user data and recovery. Nostr gives you signed events and relays. Wallet products give you value movement. A records layer tries to keep the private context from disappearing between them."]}," ",{"tag":"h2","attributes":{"id":"why-this-is-different-from-a-normal-notes-app"},"children":["Why this is different from a normal notes app"]}," ",{"tag":"p","attributes":{},"children":["A normal notes app can store wallet notes, but it cannot prove much about Nostr identity, app connections or signed events without custom work. A Nostr-native records layer can attach private or encrypted state to the same public-key model that drives the rest of the account."]}," ",{"tag":"p","attributes":{},"children":["That does not mean everything should go on relays. Sensitive records need encryption before storage. Some secrets should not be uploaded at all. Some recovery materials belong offline. The value of a Safebox-style idea is not that it stores everything. It is that it forces the product to separate public proof, encrypted state and offline responsibility."]}," ",{"tag":"h2","attributes":{"id":"the-recovery-question"},"children":["The recovery question"]}," ",{"tag":"p","attributes":{},"children":["Recovery is where wallet products become honest. If a person loses a phone, changes client, rotates a signer or moves to a new wallet service, what survives? Public Nostr identity may survive if the key is backed up. Wallet funds may survive if the wallet recovery path works. But the connection map, receipts, notes and private state can disappear if no one designed for them."]}," ",{"tag":"p","attributes":{},"children":["A records layer should help with that middle zone. It should not pretend to recover what it never stored. It should not store main private keys casually. It should make the difference between identity keys, wallet connection secrets, Cashu token proofs and ordinary notes painfully clear."]}," ",{"tag":"h2","attributes":{"id":"where-nostr-helps"},"children":["Where Nostr helps"]}," ",{"tag":"p","attributes":{},"children":["Nostr helps because it gives records a portable addressing model. A signed event can say this encrypted blob, this pointer, this label or this wallet-related note belongs to this identity. Relays can make the record available across clients. NIP-44-style encryption can protect payloads when implemented correctly."]}," ",{"tag":"p","attributes":{},"children":["The tradeoff is persistence. A relay may keep ciphertext long after you forgot it existed. If encryption is weak, passwords are bad or metadata is too revealing, the record becomes a liability. Safebox-style products need to design deletion, rotation and visibility with the same seriousness as wallet spending."]}," ",{"tag":"h2","attributes":{"id":"where-it-connects-to-crays"},"children":["Where it connects to Crays"]}," ",{"tag":"p","attributes":{},"children":["Crays has creator profiles, paid content, awards, community status and future wallet flows in the same broad world. That means records matter. A paid access right, a copyright license, a fan vote, a creator reward and a private purchase note cannot all be treated like a public zap."]}," ",{"tag":"p","attributes":{},"children":["The product should know which pieces are public proof, which pieces are private business records and which pieces are wallet permissions. Safebox points toward that problem. It should be described as a serious records lane, not as a vague wallet miracle."]}," ",{"tag":"h2","attributes":{"id":"what-to-verify"},"children":["What to verify"]}," ",{"tag":"p","attributes":{},"children":["Before trusting any sovereign records stack, verify the source, encryption model, export path, recovery story, data deletion limits and relationship to wallet secrets. Does it store real private keys? Does it store NWC secrets? Does it store Cashu proofs? Does it encrypt locally? Can you move records to another client? Does the UI warn you about irreversible exposure?"]}," ",{"tag":"p","attributes":{},"children":["If those answers are vague, treat the project as an idea to watch rather than infrastructure to trust."]}," ",{"tag":"h2","attributes":{"id":"why-it-still-belongs-here"},"children":["Why it still belongs here"]}," ",{"tag":"p","attributes":{},"children":["Wallets are moving from isolated money apps into a broader identity and commerce layer. That makes record design unavoidable. You cannot build creator payments, fan access, grants, voting, marketplaces and private invoices without a place to reason about state."]}," ",{"tag":"p","attributes":{},"children":["Safebox is the reminder: the payment is only one moment. The record around the payment is where trust either becomes durable or quietly falls apart."]}," ",{"tag":"h2","attributes":{"id":"sources-worth-opening"},"children":["Sources worth opening"]}," ",{"tag":"p","attributes":{},"children":["Open these when you want the specification, product documentation or implementation trail behind the article."]}," ",{"tag":"ul","attributes":{},"children":[" ",{"tag":"li","attributes":{},"children":[{"tag":"a","attributes":{"href":"https://github.com/nostr-protocol/nostr","target":"_blank","rel":"noreferrer noopener"},"children":["Nostr protocol repository"]}]}," ",{"tag":"li","attributes":{},"children":[{"tag":"a","attributes":{"href":"https://github.com/nostr-protocol/nips/blob/master/44.md","target":"_blank","rel":"noreferrer noopener"},"children":["NIP-44: Versioned Encryption"]}]}," ",{"tag":"li","attributes":{},"children":[{"tag":"a","attributes":{"href":"https://github.com/nostr-protocol/nips/blob/master/47.md","target":"_blank","rel":"noreferrer noopener"},"children":["NIP-47: Nostr Wallet Connect"]}]}," ",{"tag":"li","attributes":{},"children":[{"tag":"a","attributes":{"href":"https://cashu.space/","target":"_blank","rel":"noreferrer noopener"},"children":["Cashu"]}]}," "]}," ",{"tag":"h2","attributes":{"id":"useful-next-pages"},"children":["Useful next pages"]}," ",{"tag":"nav","attributes":{"className":"crays-nostr-apps-ecosystem-nav","aria-label":"Related Wallet routes"},"children":[{"tag":"a","attributes":{"href":"/nostr/wallets/security-and-recovery/"},"children":["Security and recovery"]},{"tag":"a","attributes":{"href":"/nostr/privacy/encryption-and-metadata/"},"children":["Encryption and metadata"]},{"tag":"a","attributes":{"href":"/nostr/commerce/"},"children":["Commerce"]},{"tag":"a","attributes":{"href":"/nostr/crays/"},"children":["Crays"]}]}," ",{"tag":"div","attributes":{"className":"crays-article-end"},"children":[{"tag":"a","attributes":{"href":"/nostr/wallets/"},"children":["Back to Wallets"]}]}," "]}," "]}," "]}," "]}," ",{"tag":"section","attributes":{"className":"crays-nostr-hub-image-band crays-nostr-apps-collage crays-nostr-route-collage crays-nostr-wallets-collage","id":"safebox-and-sovereign-wallet-records-wallet-close","aria-label":"Safebox and Sovereign Wallet Records visual separator"},"children":[" ",{"tag":"div","attributes":{"className":"crays-article-shell crays-nostr-hub-image-band__grid"},