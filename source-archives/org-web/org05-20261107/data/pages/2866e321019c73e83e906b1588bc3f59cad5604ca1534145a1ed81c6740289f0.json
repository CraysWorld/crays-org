r","--nostr-hero-bg-size":"cover"}},"children":["\n    ",{"tag":"div","attributes":{"className":"crays-article-shell crays-article-hero__grid"},"children":["\n      ",{"tag":"div","attributes":{"className":"crays-article-hero__content"},"children":["\n        ",{"tag":"p","attributes":{"className":"crays-article-kicker"},"children":["Governance"]},"\n        ",{"tag":"h1","attributes":{},"children":["Governance Without One King"]},"\n        ",{"tag":"p","attributes":{"className":"crays-article-deck"},"children":["Governance on Nostr is the art of making rules, trust and exits visible without turning the protocol into a company."]},"\n        ",{"tag":"nav","attributes":{"className":"crays-nostr-article-related","aria-label":"Related Governance pages"},"children":["\n        ",{"tag":"a","attributes":{"href":"/nostr/governance/deep-dives/moderation-without-a-king/"},"children":["Moderation without one king"]},"\n        ",{"tag":"a","attributes":{"href":"/nostr/governance/deep-dives/badges-status-and-reputation/"},"children":["Badges and reputation"]},"\n        ",{"tag":"a","attributes":{"href":"/nostr/governance/field-guide/legal-risk/"},"children":["Legal risk"]},"\n      "]},"\n      "]},"\n      ",{"tag":"figure","attributes":{"className":"crays-article-hero__media"},"children":["\n        ",{"tag":"img","attributes":{"src":"/assets/stock-lifestyle/crays-association-23-crays-association-members-preparing-a-project-decision.webp","alt":"Members preparing a public decision with rules, records and accountability.","loading":"eager","decoding":"async"},"children":[]},"\n      "]},"\n    "]},"\n  "]},"\n\n  ",{"tag":"article","attributes":{"className":"crays-article-shell crays-nostr-article"},"children":["\n    ",{"tag":"section","attributes":{"className":"crays-nostr-article-intro"},"children":["\n      ",{"tag":"p","attributes":{"className":"crays-nostr-live-kicker"},"children":["Start here"]},"\n      ",{"tag":"h2","attributes":{},"children":["The open network still needs rules."]},"\n      ",{"tag":"p","attributes":{},"children":["Nostr governance starts from a strange but useful premise: no single company owns the public square, so no single company can be the only judge, moderator, identity provider, badge issuer, search index, archive host or court of appeal. That does not remove governance. It spreads governance across keys, clients, relays, communities, lists, labels, reports, badges, conventions and real-world law."]},"\n",{"tag":"p","attributes":{},"children":["That is why this part of the archive is not about boardroom theater. It is about the small decisions that shape whether an open protocol remains usable. Who can issue a badge? What does a report actually prove? When does a mute list become a safety tool, and when does it become a quiet blacklist? When a relay rejects abuse, what should a client show you? When a community moderates posts, where are the rules? Those questions are governance."]},"\n",{"tag":"p","attributes":{},"children":["The protocol gives you signed events. Everything after that is social design. You need enough structure to defend people from spam, scams, impersonation and harassment, but not so much structure that one gatekeeper can decide who exists. Nostr's answer is plural: many clients, many relays, many communities, many lists, many trust signals. The cost is complexity. The gain is exit."]},"\n    "]},"\n    \n    ",{"tag":"section","attributes":{"className":"crays-nostr-article-section"},"children":["\n      ",{"tag":"h2","attributes":{},"children":["Protocol governance is intentionally narrow"]},"\n      ",{"tag":"p","attributes":{},"children":["Nostr does not begin with a constitution, a foundation board or a platform policy team. It begins with events, signatures and relays. NIPs describe how clients and relays can understand one another. Some NIPs are core, some are optional, some are experimental, and many never become the center of daily use. That looseness can feel messy, but it prevents the standard from becoming a permission slip."]},"\n",{"tag":"p","attributes":{},"children":["The important distinction is this: a NIP can define interoperability, but it cannot force culture. NIP-01 can explain the client-relay model. NIP-32 can define labels. NIP-56 can define reports. NIP-58 can define badges. None of those documents can decide whether a community is fair, whether a badge issuer is honest, or whether a report is good faith. The standard gives the shape of the record. People still judge the record."]},"\n",{"tag":"p","attributes":{},"children":["That is a healthier starting point than pretending protocol text solves social conflict. The best Nostr governance pages show the boundary. They tell you what the signed data can prove, what the app is adding, what the relay is enforcing and where human context begins."]},"\n    "]},"\n",{"tag":"section","attributes":{"className":"crays-nostr-hub-image-band crays-nostr-apps-collage crays-nostr-route-collage crays-nostr-governance-collage","id":"-nostr-governance-guide--1","aria-label":"Governance Without One King visual break"},"children":["\n  ",{"tag":"div","attributes":{"className":"crays-article-shell crays-nostr-hub-image-band__grid"},"children":["\n    ",{"tag":"figure","attributes":{"className":"is-wide"},"children":[{"tag":"img","attributes":{"src":"/assets/stock-lifestyle/crays-association-08-the-system-stays-credible-when-decisions-are-documented-and-account.webp","alt":"A governance scene where documentation and accountability keep trust legible.","loading":"lazy","decoding":"async"},"children":[]}]},"\n    ",{"tag":"figure","attributes":{},"children":[{"tag":"img","attributes":{"src":"/assets/stock-images/crays-nostr-badge-membership-status.webp","alt":"A Nostr badge and membership status visual for reputation and public context.","loading":"lazy","decoding":"async"},"children":[]}]},"\n    ",{"tag":"figure","attributes":{"className":"is-wide"},"children":[{"tag":"img","attributes":{"src":"/assets/stock-lifestyle/crays-association-12-crays-management-discussion-around-a-business-table.webp","alt":"A focused table discussion about standards, membership and project rules.","loading":"lazy","decoding":"async"},"children":[]}]},"\n    ",{"tag":"figure","attributes":{},"children":[{"tag":"img","attributes":{"src":"/assets/stock-lifestyle/crays-association-03-crays-operating-and-governance-team-in-a-focused-meeting.webp","alt":"A governance team working through operational decisions.","loading":"lazy","decoding":"async"},"children":[]}]},"\n    ",{"tag":"figure","attributes":{},"children":[{"tag":"img","attributes":{"src":"/assets/stock-lifestyle/crays-association-22-crays-project-and-partner-discussion-connected-to-the-governance-la.webp","alt":"Project and partner discussion connected to a governance layer.","loading":"lazy","decoding":"async"},"children":[]}]},"\n  "]},"\n"]},"\n    ",{"tag":"section","attributes":{"className":"crays-nostr-article-section"},"children":["\n      ",{"tag":"h2","attributes":{},"children":["Moderation moves from headquarters to surfaces"]},"\n      ",{"tag":"p","attributes":{},"children":["In a platform, moderation often feels like a weather system: it arrives from above, with limited explanation, and your account simply has to live under it. In Nostr, moderation is pushed toward the edges. A relay can reject events. A client can hide content. A community can enforce rules. A user can mute, block, follow a curated list or ignore a label. That does not make moderation disappear. It makes the location of moderation visible."]},"\n",{"tag":"p","attributes":{},"children":["That visibility is the whole point. If a relay rejects spam, you can choose another relay. If a client hides a public feud, you can open the same key elsewhere. If a community has strict rules, you can decide whether that room is useful for you. Exit is not magic; you still need alternative relays, clients and social discovery. But exit is a governance tool when it is real."]},"\n",{"tag":"p","attributes":{},"children":["The hard part is abuse. Open networks invite spam, impersonation, harassment, malware, illegal content and coordinated manipulation. Nostr cannot stay useful by pretending those problems are fake. It stays useful when the response is legible: reports, labels, relay policies, client controls, moderation logs and trusted lists that can be inspected instead of silently imposed."]},"\n    "]},"\n\n    ",{"tag":"section","attributes":{"className":"crays-nostr-article-section"},"children":["\n      ",{"tag":"h2","attributes":{},"children":["Reputation needs receipts, not vibes"]},"\n      ",{"tag":"p","attributes":{},"children":["Reputation is dangerous when it becomes a secret score. It is more useful when it stays close to public receipts. A badge can say someone earned a role or membership. A label can say a piece of content has a category or warning. A report can say someone flagged an event for a reason. A list can say a person chose this set of accounts, relays or muted terms. Each signal is only as good as the issuer, context and verification around it."]},"\n",{"tag":"p","attributes":{},"children":["This is why Nostr reputation should be read as provenance, not destiny. Who made the claim? Which key signed it? Can the claim be checked? Is it portable across clients? Can it be ignored? Does it create a path to appeal, correction or exit? The moment reputation becomes an unchallengeable number, the old platform problem returns wearing open-protocol clothes."]},"\n    "]},"\n",{"tag":"section","attributes":{"className":"crays-nostr-hub-image-band crays-nostr-apps-collage crays-nostr-route-collage crays-nostr-governance-collage","id":"-nostr-governance-guide--3","aria-label":"Governance Without One King visual break"},"children":["\n  ",{"tag":"div","attributes":{"className":"crays-article-shell crays-nostr-hub-image-band__grid"},"children":["\n    ",{"tag":"figure","attributes":{"className":"is-wide"},"children":[{"tag":"img","attributes":{"src":"/assets/stock-lifestyle/crays-association-12-crays-management-discussion-around-a-business-table.webp","alt":"A focused table discussion about standards, membership and project rules.","loading":"lazy","decoding":"async"},"children":[]}]},"\n    ",{"tag":"figure","attributes":{},"children":[{"tag":"img","attributes":{"src":"/assets/stock-lifestyle/crays-association-03-crays-operating-and-governance-team-in-a-focused-meeting.webp","alt":"A governance team working through operational decisions.","loading":"lazy","decoding":"async"},"children":[]}]},"\n    ",{"tag":"figure","attributes":{"className":"is-wide"},"children":[{"tag":"img","attributes":{"src":"/assets/stock-lifestyle/crays-association-22-crays-project-and-partner-discussion-connected-to-the-governance-la.webp","alt":"Project and partner discussion connected to a governance layer.","loading":"lazy","decoding":"async"},"children":[]}]},"\n    ",{"tag":"figure","attributes":{},"children":[{"tag":"img","attributes":{"src":"/assets/stock-lifestyle/crays-association-18-crays-partners-discussing-association-standards-and-project-executi.webp","alt":"Partners discussing standards and project execution.","loading":"lazy","decoding":"async"},"children":[]}]},"\n    ",{"tag":"figure","attributes":{},"children":[{"tag":"img","attributes":{"src":"/assets/stock-lifestyle/crays-association-23-crays-association-members-preparing-a-project-decision.webp","alt":"Members preparing a public decision with rules, records and accountability.","loading":"lazy","decoding":"async"},"children":[]}]},"\n  "]},"\n"]},"\n    ",{"tag":"section","attributes":{"className":"crays-nostr-article-section"},"children":["\n      ",{"tag":"h2","attributes":{},"children":["Governance also touches law"]},"\n      ",{"tag":"p","attributes":{},"children":["A decentralized network still lives in the real world. Relays can receive complaints. App operators can face store rules. Event organizers can have safety obligations. European platforms deal with Digital Services Act duties around illegal content, transparency and redress. Copyright, defamation, consumer protection and privacy law do not vanish because an event is signed."]},"\n",{"tag":"p","attributes":{},"children":["The practical lesson is not to panic. It is to design governance pages honestly. Separate protocol capability from operator responsibility. Name the layer that can act. Keep public claims linked to sources. Avoid pretending a badge, label, report or vote is more authoritative than it is. The best governance on Nostr is humble, inspectable and portable."]},"\n    "]},"\n    ",{"tag":"section","attributes":{"className":"crays-nostr-article-sources","aria-label":"Sources"},"children":["\n    ",{"tag":"h2","attributes":{},"children":["Sources"]},"\n    ",{"tag":"ul","attributes":{},"children":["\n      ",{"tag":"li","attributes":{},"children":[{"tag":"a","attributes":{"href":"https://github.com/nostr-protocol/nips"},"children":["NIP repository"]}]},"\n      ",{"tag":"li","attributes":{},"children":[{"tag":"a","attributes":{"href":"https://github.com/nostr-protocol/nips/blob/master/01.md"},"children":["NIP-01: basic protocol flow"]}]},"\n      ",{"tag":"li","attributes":{},"children":[{"tag":"a","attributes":{"href":"https://github.com/nostr-protocol/nips/blob/master/32.md"},"children":["NIP-32: labeling"]}]},"\n      ",{"tag":"li","attributes":{},"children":[{"tag":"a","attributes":{"href":"https://github.com/nostr-protocol/nips/blob/master/56.md"},"children":["NIP-56: reporting"]}]},"\n      ",{"tag":"li","attributes":{},"children":[{"tag":"a","attributes":{"href":"https://github.com/nostr-protocol/nips/blob/master/58.md"},"children":["NIP-58: badges"]}]},"\n      ",{"tag":"li","attributes":{},"children":[{"tag":"a","attributes":{"href":"https://digital-strategy.ec.europa.eu/en/policies/digital-services-act-package"},"children":["European Commission: Digital Services Act"]}]},"\n      ",{"tag":"li","attributes":{},"children":[{"tag":"a","attributes":{"href":"https://eur-lex.europa.eu/eli/reg/2022/2065/oj"},"children":["EU DSA Regulation text"]}]},"\n    "]},"\n  "]},"\n  "]},"\n"]},"\n",{"tag":"footer","attributes":{"className":"legal-footer crays-nostr-footer","aria-label":"Crays footer"},"children":["\n    ",{"tag":"div","attributes":{"className":"legal-footer-inner"},"children":["\n      ",{"tag":"div","attributes":{"className":"legal-footer-top"},"children":["\n        ",{"tag":"div","attributes":{},"children":["\n          ",{"tag":"a","attributes":{"className":"legal-footer-logo-link","href":"/","aria-label":"Crays Home"},"children":["\n            ",{"tag":"img","attributes":{"className":"legal-footer-logo","src":"/assets/brand/crays-logo.svg","alt":"Crays","width":"138","height":"34","loading":"lazy"},"children":[]},"\n          "]},"\n          ",{"tag":"p","attributes":{"className":"legal-footer-tagline"},"children":["Luxury, Lifestyle, Wealth and Innovation"]},"\n        "]},"\n        ",{"tag":"div","attributes":{"className":"legal-footer-social","aria-label":"Social links"},"children":[{"tag":"a","attributes":{"href":"https://github.com/CraysCircle","aria-label":"GitHub","target":"_blank","rel":"noreferrer noopener"},"children":[{"tag":"img","attributes":{"src":"/assets/footer-icons/github.svg","alt":"GitHub","width":"20","height":"20","loading":"lazy"},"children":[]}]},{"tag":"a","attributes":{"href":"https://x.com/CraysCircle","aria-label":"X","target":"_blank","rel":"noreferrer noopener"},"children":[{"tag":"img","attributes":{"src":"/assets/footer-icons/x.svg","alt":"X","width":"20","height":"20","loading":"lazy"},"children":[]}]},{"tag":"a","attributes":{"href":"https://opencollective.com/crays","aria-label":"Open Collective","target":"_blank","rel":"noreferrer noopener"},"children":[{"tag":"img","attributes":{"src":"/assets/footer-icons/opencollective.svg","alt":"Open Collective","width":"20","height":"20","loading":"lazy"},"children":[]