\n  ",{"tag":"section","attributes":{"className":"crays-article-hero crays-nostr-hub-hero","style":{"--nostr-hero-bg":"url(/assets/stock-lifestyle/crays-association-03-crays-operating-and-governance-team-in-a-focused-meeting.webp)","--nostr-hero-bg-position":"center center","--nostr-hero-bg-size":"cover"}},"children":["\n    ",{"tag":"div","attributes":{"className":"crays-article-shell crays-article-hero__grid"},"children":["\n      ",{"tag":"div","attributes":{"className":"crays-article-hero__content"},"children":["\n        ",{"tag":"p","attributes":{"className":"crays-article-kicker"},"children":["Governance"]},"\n        ",{"tag":"h1","attributes":{},"children":["Lists, Mutes and Curation as Personal Governance"]},"\n        ",{"tag":"p","attributes":{"className":"crays-article-deck"},"children":["Lists are quiet governance: they decide what you see, what you ignore, which relays you trust and which communities feel usable."]},"\n        ",{"tag":"nav","attributes":{"className":"crays-nostr-article-related","aria-label":"Related Governance pages"},"children":["\n        ",{"tag":"a","attributes":{"href":"/nostr/governance/deep-dives/moderation-without-a-king/"},"children":["Moderation"]},"\n        ",{"tag":"a","attributes":{"href":"/nostr/governance/field-guide/labels/"},"children":["Labels"]},"\n      "]},"\n      "]},"\n      ",{"tag":"figure","attributes":{"className":"crays-article-hero__media"},"children":["\n        ",{"tag":"img","attributes":{"src":"/assets/stock-lifestyle/crays-association-03-crays-operating-and-governance-team-in-a-focused-meeting.webp","alt":"A governance team working through operational decisions.","loading":"eager","decoding":"async"},"children":[]},"\n      "]},"\n    "]},"\n  "]},"\n\n  ",{"tag":"article","attributes":{"className":"crays-article-shell crays-nostr-article"},"children":["\n    ",{"tag":"section","attributes":{"className":"crays-nostr-article-intro"},"children":["\n      ",{"tag":"p","attributes":{"className":"crays-nostr-live-kicker"},"children":["Curation"]},"\n      ",{"tag":"h2","attributes":{},"children":["Your feed is governed before you call it a feed."]},"\n      ",{"tag":"p","attributes":{},"children":["A feed looks personal, but it is built from decisions: who you follow, which lists you trust, what you mute, which relays your client reads, which labels it honors and which communities it opens by default. NIP-51 matters because it gives Nostr a standard way to represent lists."]},"\n",{"tag":"p","attributes":{},"children":["Lists are easy to underestimate. A mute list can protect your attention. A follow list can create a cultural neighborhood. A relay list can determine whether your events are found. A curated list can create soft moderation without pretending to be universal law."]},"\n    "]},"\n    \n    ",{"tag":"section","attributes":{"className":"crays-nostr-article-section"},"children":["\n      ",{"tag":"h2","attributes":{},"children":["Personal choice can scale without becoming a ruler"]},"\n      ",{"tag":"p","attributes":{},"children":["In a centralized platform, curation becomes ranking power. In Nostr, curation can remain plural. You can use one client, follow one set of lists, trust one community's moderation choices, then switch when the choices no longer fit. That is personal governance."]},"\n",{"tag":"p","attributes":{},"children":["The trick is to avoid hiding the curator. If a client uses a default mute list, say so. If a community list affects visibility, name it. If a relay list shapes discovery, show it. Silent curation creates the same suspicion that made people distrust old platforms."]},"\n    "]},"\n",{"tag":"section","attributes":{"className":"crays-nostr-hub-image-band crays-nostr-apps-collage crays-nostr-route-collage crays-nostr-governance-collage","id":"-nostr-governance-deep-dives-lists-mutes-and-curation--1","aria-label":"Lists, Mutes and Curation as Personal Governance visual break"},"children":["\n  ",{"tag":"div","attributes":{"className":"crays-article-shell crays-nostr-hub-image-band__grid"},"children":["\n    ",{"tag":"figure","attributes":{"className":"is-wide"},"children":[{"tag":"img","attributes":{"src":"/assets/stock-lifestyle/crays-association-08-the-system-stays-credible-when-decisions-are-documented-and-account.webp","alt":"A governance scene where documentation and accountability keep trust legible.","loading":"lazy","decoding":"async"},"children":[]}]},"\n    ",{"tag":"figure","attributes":{},"children":[{"tag":"img","attributes":{"src":"/assets/stock-images/crays-nostr-badge-membership-status.webp","alt":"A Nostr badge and membership status visual for reputation and public context.","loading":"lazy","decoding":"async"},"children":[]}]},"\n    ",{"tag":"figure","attributes":{"className":"is-wide"},"children":[{"tag":"img","attributes":{"src":"/assets/stock-lifestyle/crays-association-12-crays-management-discussion-around-a-business-table.webp","alt":"A focused table discussion about standards, membership and project rules.","loading":"lazy","decoding":"async"},"children":[]}]},"\n    ",{"tag":"figure","attributes":{},"children":[{"tag":"img","attributes":{"src":"/assets/stock-lifestyle/crays-association-03-crays-operating-and-governance-team-in-a-focused-meeting.webp","alt":"A governance team working through operational decisions.","loading":"lazy","decoding":"async"},"children":[]}]},"\n    ",{"tag":"figure","attributes":{},"children":[{"tag":"img","attributes":{"src":"/assets/stock-lifestyle/crays-association-22-crays-project-and-partner-discussion-connected-to-the-governance-la.webp","alt":"Project and partner discussion connected to a governance layer.","loading":"lazy","decoding":"async"},"children":[]}]},"\n  "]},"\n"]},"\n    ",{"tag":"section","attributes":{"className":"crays-nostr-article-section"},"children":["\n      ",{"tag":"h2","attributes":{},"children":["Mute lists are safety tools and political tools"]},"\n      ",{"tag":"p","attributes":{},"children":["A mute list can block spam, slurs, scams, stalkers and noise. It can also hide dissent, flatten debate or create an invisible social caste. Both are true. The answer is not to ban lists. The answer is to make the signer, scope and consequences visible."]},"\n",{"tag":"p","attributes":{},"children":["A good UX treats mutes as reversible, inspectable and local by default. You should know whether you muted an account yourself, imported a list, accepted a community filter or inherited a client setting. That single distinction changes whether a person feels in control."]},"\n    "]},"\n\n    ",{"tag":"section","attributes":{"className":"crays-nostr-article-section"},"children":["\n      ",{"tag":"h2","attributes":{},"children":["Curation is where community becomes culture"]},"\n      ",{"tag":"p","attributes":{},"children":["Nostr communities are not held together only by protocol. They are held together by people who make lists, host rooms, run relays, publish guides, moderate groups and signal quality. Curation is the human layer that turns an event firehose into a place."]},"\n    "]},"\n",{"tag":"section","attributes":{"className":"crays-nostr-hub-image-band crays-nostr-apps-collage crays-nostr-route-collage crays-nostr-governance-collage","id":"-nostr-governance-deep-dives-lists-mutes-and-curation--3","aria-label":"Lists, Mutes and Curation as Personal Governance visual break"},"children":["\n  ",{"tag":"div","attributes":{"className":"crays-article-shell crays-nostr-hub-image-band__grid"},"children":["\n    ",{"tag":"figure","attributes":{"className":"is-wide"},"children":[{"tag":"img","attributes":{"src":"/assets/stock-lifestyle/crays-association-12-crays-management-discussion-around-a-business-table.webp","alt":"A focused table discussion about standards, membership and project rules.","loading":"lazy","decoding":"async"},"children":[]}]},"\n    ",{"tag":"figure","attributes":{},"children":[{"tag":"img","attributes":{"src":"/assets/stock-lifestyle/crays-association-03-crays-operating-and-governance-team-in-a-focused-meeting.webp","alt":"A governance team working through operational decisions.","loading":"lazy","decoding":"async"},"children":[]}]},"\n    ",{"tag":"figure","attributes":{"className":"is-wide"},"children":[{"tag":"img","attributes":{"src":"/assets/stock-lifestyle/crays-association-22-crays-project-and-partner-discussion-connected-to-the-governance-la.webp","alt":"Project and partner discussion connected to a governance layer.","loading":"lazy","decoding":"async"},"children":[]}]},"\n    ",{"tag":"figure","attributes":{},"children":[{"tag":"img","attributes":{"src":"/assets/stock-lifestyle/crays-association-18-crays-partners-discussing-association-standards-and-project-executi.webp","alt":"Partners discussing standards and project execution.","loading":"lazy","decoding":"async"},"children":[]}]},"\n    ",{"tag":"figure","attributes":{},"children":[{"tag":"img","attributes":{"src":"/assets/stock-lifestyle/crays-association-23-crays-association-members-preparing-a-project-decision.webp","alt":"Members preparing a public decision with rules, records and accountability.","loading":"lazy","decoding":"async"},"children":[]}]},"\n  "]},"\n"]},"\n    ",{"tag":"section","attributes":{"className":"crays-nostr-article-section"},"children":["\n      ",{"tag":"h2","attributes":{},"children":["Default lists are hidden politics"]},"\n      ",{"tag":"p","attributes":{},"children":["The first experience of Nostr is often shaped by defaults: starter follows, default relays, suggested accounts, trending clients, recommended mute lists and community links. Those defaults are not evil. They are necessary for orientation. But they are political in the small-p sense because they decide who appears normal, who appears absent and which corners of the network feel alive."]},"\n",{"tag":"p","attributes":{},"children":["A good hub should therefore treat lists as cultural infrastructure. A developer list can make builders visible. A creator list can make media culture legible. A mute list can make a room safer. A relay list can make posts reachable. The issue is not whether lists exist. The issue is whether you know whose list you are using and what it leaves out."]},"\n    "]},"\n\n    ",{"tag":"section","attributes":{"className":"crays-nostr-article-section"},"children":["\n      ",{"tag":"h2","attributes":{},"children":["Curation can be generous instead of controlling"]},"\n      ",{"tag":"p","attributes":{},"children":["The best curators do not pretend to own the network. They make paths. They show you a scene, a language group, a topic, a conference, a builder cluster or a safety practice. You can follow the path, fork it, ignore it or build a better one. That is a very different relationship from a platform ranking model where the curator is invisible and the feed feels inevitable."]},"\n    "]},"\n\n    ",{"tag":"section","attributes":{"className":"crays-nostr-article-section"},"children":["\n      ",{"tag":"h2","attributes":{},"children":["List reputation needs maintenance"]},"\n      ",{"tag":"p","attributes":{},"children":["A list that was useful six months ago may become stale. People change keys, projects die, relays go offline, communities split and spam patterns move. Governance includes list maintenance: dates, descriptions, issuers, update rhythm and a way for people to understand why they are seeing a recommendation."]},"\n    "]},"\n    ",{"tag":"section","attributes":{"className":"crays-nostr-article-sources","aria-label":"Sources"},"children":["\n    ",{"tag":"h2","attributes":{},"children":["Sources"]},"\n    ",{"tag":"ul","attributes":{},"children":["\n      ",{"tag":"li","attributes":{},"children":[{"tag":"a","attributes":{"href":"https://github.com/nostr-protocol/nips/blob/master/51.md"},"children":["NIP-51: lists"]}]},"\n      ",{"tag":"li","attributes":{},"children":[{"tag":"a","attributes":{"href":"https://github.com/nostr-protocol/nips/blob/master/32.md"},"children":["NIP-32: labeling"]}]},"\n      ",{"tag":"li","attributes":{},"children":[{"tag":"a","attributes":{"href":"https://github.com/nostr-protocol/nips/blob/master/29.md"},"children":["NIP-29: relay-based groups"]}]},"\n      ",{"tag":"li","attributes":{},"children":[{"tag":"a","attributes":{"href":"https://github.com/nostr-protocol/nips/blob/master/72.md"},"children":["NIP-72: moderated communities"]}]},"\n    "]},"\n  "]},"\n  "]},"\n"]},"\n",{"tag":"footer","attributes":{"className":"legal-footer crays-nostr-footer","aria-label":"Crays footer"},"children":["\n    ",{"tag":"div","attributes":{"className":"legal-footer-inner"},"children":["\n      ",{"tag":"div","attributes":{"className":"legal-footer-top"},"children":["\n        ",{"tag":"div","attributes":{},"children":["\n          ",{"tag":"a","attributes":{"className":"legal-footer-logo-link","href":"/","aria-label":"Crays Home"},"children":["\n            ",{"tag":"img","attributes":{"className":"legal-footer-logo","src":"/assets/brand/crays-logo.svg","alt":"Crays","width":"138","height":"34","loading":"lazy"},"children":[]},"\n          "]},"\n          ",{"tag":"p","attributes":{"className":"legal-footer-tagline"},"children":["Luxury, Lifestyle, Wealth and Innovation"]},"\n        "]},"\n        ",{"tag":"div","attributes":{"className":"legal-footer-social","aria-label":"Social links"},"children":[{"tag":"a","attributes":{"href":"https://github.com/CraysCircle","aria-label":"GitHub","target":"_blank","rel":"noreferrer noopener"},"children":[{"tag":"img","attributes":{"src":"/assets/footer-icons/github.svg","alt":"GitHub","width":"20","height":"20","loading":"lazy"},"children":[]}]},{"tag":"a","attributes":{"href":"https://x.com/CraysCircle","aria-label":"X","target":"_blank","rel":"noreferrer noopener"},"children":[{"tag":"img","attributes":{"src":"/assets/footer-icons/x.svg","alt":"X","width":"20","height":"20","loading":"lazy"},"children":[]}]},{"tag":"a","attributes":{"href":"https://opencollective.com/crays","aria-label":